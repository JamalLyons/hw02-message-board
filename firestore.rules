rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Private user record: written once by its owner at registration.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['uid', 'firstName', 'lastName', 'role', 'registrationDateTime'])
        && request.resource.data.keys().hasAll(
             ['uid', 'firstName', 'lastName', 'role', 'registrationDateTime'])
        && request.resource.data.uid == uid
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.role is string
        && request.resource.data.registrationDateTime == request.time;
      allow update, delete: if false;

      // Notification prefs: owner only.
      match /prefs/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // Public board: signed-in users read everything,
    // but create/update/delete only their own messages.
    match /messages/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['text', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.editedAt == request.time;
      allow delete: if signedIn()
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
